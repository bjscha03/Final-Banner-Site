# Retired product details open their product configurator directly.
/yard-signs   /design?product=yard-signs   301!
/car-magnets   /design?product=car-magnets   301!
/trade-show-banners   /design?product=banner   301!
/food-truck-banners   /design?product=banner   301!
/outdoor-banners   /design?product=banner   301!
/indoor-banners   /design?product=banner   301!
/event-banners   /design?product=banner   301!
/custom-banners   /design?product=banner   301!
/construction-banners   /design?product=banner   301!

# Retired material pages now open the banner designer with a material selected.
/vinyl-banners   /design?product=banner&material=13oz   301!
/mesh-banners    /design?product=banner&material=mesh   301!

# Double-sided printing is now an option in the main banner designer.
/double-sided-banners   /.netlify/functions/redirect-double-sided-banner   200!

# API routing for Netlify Functions
# Keep the historical PayPal compatibility routes ahead of the broad API
# rewrite. Netlify uses the first matching rule, and the generic mapping would
# otherwise look for nonexistent `paypal/create-order` function paths.
/api/paypal/create-order   /.netlify/functions/paypal-create-order   200
/api/paypal/capture-order  /.netlify/functions/paypal-capture-order  200
/api/*   /.netlify/functions/:splat   200

# Server-rendered public referral card, before the SPA fallback.
/bof-cash-test/share/:code   /.netlify/functions/bof-cash-test?action=share&code=:code   200!
/refer/:code   /.netlify/functions/bof-referral?code=:code   200!

# Direct test pages - serve as-is (no React routing)
/ai-test-direct.html   /ai-test-direct.html   200
/ai-button-test.html   /ai-button-test.html   200

# Backward compatibility for the first AI test email that linked to /designer.
# Keep already-delivered emails useful by routing that old URL into the live
# banner builder instead of the 404 page.
/designer   /design?product=banner   302!

# Retired seasonal campaign pages and server functions. These rules belong
# here as well as netlify.toml so production, branch, and preview contexts all
# resolve them before the SPA catch-all below.
/graduation-signs/*   /design?product=banner   301!
/graduation-signs     /design?product=banner   301!
/proof/*              /design?product=banner   301!

# Retired city pages and unknown children
# under these namespaces return a real 404 instead of the SPA.
/vinyl-banners/*   /404.html   404
/yard-signs/*      /404.html   404
/car-magnets/*     /404.html   404
/products/*        /404.html   404
/trade-shows       /404.html   404!
/trade-shows/*     /404.html   404!

# Existing hashed assets shadow this non-forced rule. Missing/stale chunks must
# return a real 404 instead of the SPA HTML shell.
/assets/*          /404.html   404

# SPA fallback for React Router (must be last)
/*    /index.html   200
