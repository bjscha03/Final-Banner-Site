# ============================================================================
# Print Pipeline (Beta) - Feature Flag
# ============================================================================

# Enable/disable the print pipeline feature
# When false: Site behaves exactly as before (no new buttons, no new endpoints)
# When true: Enables Print-Grade PDF, Quality Check, and AI print derivatives
ENABLE_PRINT_PIPELINE=false

# Print Pipeline Configuration
PRINT_DEFAULT_DPI=300
PRINT_BLEED_IN=0.25
PRINT_COLOR_SPACE=srgb
PRINT_FORMAT=jpeg

# ============================================================================
# Vite Environment Variables (Client-Side)
# ============================================================================

# These must be prefixed with VITE_ to be accessible in the browser
VITE_ENABLE_PRINT_PIPELINE=false
VITE_PRINT_DEFAULT_DPI=300
VITE_PRINT_BLEED_IN=0.25
VITE_PRINT_FORMAT=jpeg

# AI Upscale Hook (scaffolding – requires Cloudinary AI Super Resolution add-on)
# When true, the upscaleForPrint utility applies Cloudinary AI upscale before export
ENABLE_UPSCALE=false
VITE_ENABLE_UPSCALE=false

# ============================================================================
# Cloudinary Configuration (Required for print derivatives)
# ============================================================================

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client-side Cloudinary (for URL generation)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# ============================================================================
# Canva Integration
# ============================================================================

# Canva app preview base URL (from Canva app configuration)
CANVA_PREVIEW_BASE=https://your-canva-app-preview-url.com

# Canva client secret for webhook signature verification
CANVA_CLIENT_SECRET=your_canva_client_secret

# Cloudinary configuration for Canva uploads
CLOUDINARY_CLOUD_NAME=dtrx1l20u
CLOUDINARY_UNSIGNED_PRESET=canva_upload

# ============================================================================
# PostHog Analytics (for promo tracking and user analytics)
# ============================================================================

# PostHog API key (get from PostHog project settings)
VITE_POSTHOG_API_KEY=your_posthog_api_key

# PostHog host (default: https://app.posthog.com, or use self-hosted URL)
VITE_POSTHOG_HOST=https://app.posthog.com

# ============================================================================
# ============================================================================
# Email Provider (Resend) - For discount code emails
# ============================================================================

# Resend API key for sending transactional emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# From email address (must be verified in Resend)
EMAIL_FROM=orders@bannersonthefly.com

EMAIL_REPLY_TO=support@bannersonthefly.com

# ============================================================================
# PayPal (server-side only)
# ============================================================================

FEATURE_PAYPAL=0
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID_SANDBOX=
PAYPAL_SECRET_SANDBOX=
PAYPAL_CLIENT_ID_LIVE=
PAYPAL_SECRET_LIVE=
PAYPAL_WEBHOOK_ID=

# ============================================================================
# AI Sales Engine (server-side only; production remains Shadow-locked)
# ============================================================================

# The checked-in code also hard-locks live delivery and production automation.
# Keep these false until a separately reviewed activation change.
OUTBOUND_SALES_ENABLED=false
OUTBOUND_LIVE_SENDING_AVAILABLE=false

# Leave every secret blank in source-controlled files. Configure secrets only
# in server-side deployment scopes; never add a VITE_ prefix and never reuse
# the AI Banner Designer or transactional-email credentials.
OUTBOUND_OPENAI_API_KEY=
# Placeholder only. Resend's current AUP prohibits cold outreach; do not set
# this unless written authorization for the exact use case is reviewed.
OUTBOUND_RESEND_API_KEY=
OUTBOUND_RESEND_WEBHOOK_SECRET=
OUTBOUND_UNSUBSCRIBE_SIGNING_SECRET=
OUTBOUND_AUTOMATION_SECRET=
OUTBOUND_FROM_EMAIL=
OUTBOUND_REPLY_TO_EMAIL=
OUTBOUND_PHYSICAL_ADDRESS=
# Required for the permissioned one-at-a-time Admin > Sales > Lead Review send button.
# Use the business's valid postal address; the recipient must have explicitly opted in.
OUTBOUND_PERMISSIONED_RESEND_API_KEY=
OUTBOUND_PERMISSIONED_FROM_EMAIL=info@bannersonthefly.com
OUTBOUND_PERMISSIONED_REPLY_TO_EMAIL=support@bannersonthefly.com
OUTBOUND_EMAIL_VERIFICATION_API_KEY=
OUTBOUND_GOOGLE_PLACES_API_KEY=
OUTBOUND_APOLLO_API_KEY=
OUTBOUND_APOLLO_CREDIT_COST_MICROUSD=
OUTBOUND_CLAY_API_KEY=
OUTBOUND_DATA_AXLE_API_KEY=
OUTBOUND_YELP_API_KEY=

# Non-production validation gates. Never scope these to production. They are
# inert in production even if misconfigured, but explicit false values make
# deployment intent auditable.
OUTBOUND_PHASE2_SHADOW_EXECUTION_ENABLED=false
OUTBOUND_PHASE3_SHADOW_EXECUTION_ENABLED=false
OUTBOUND_SHADOW_AUTOMATION_ENABLED=false
OUTBOUND_INBOUND_VALIDATION_ENABLED=false
OUTBOUND_REPLY_AI_VALIDATION_ENABLED=false

# ============================================================================
# Google Ads Conversion Tracking
# ============================================================================

# Google Ads conversion ID (e.g. AW-1234567890). Required to fire the Google Ads
# purchase conversion event from PaymentSuccess. Leave blank to disable.
VITE_GOOGLE_ADS_CONVERSION_ID=

# Google Ads purchase conversion label (the value after the slash in send_to).
# Leave blank to disable. Both ID and label must be set for conversions to fire.
VITE_GOOGLE_ADS_PURCHASE_LABEL=

# ============================================================================
# Google Vertex AI (Imagen) — "Create with AI" feature
# ============================================================================
# Required for the /.netlify/functions/generate-design endpoint.
# Server-side only — do NOT expose to the browser.

# GCP project that has the Vertex AI API enabled.
GOOGLE_CLOUD_PROJECT_ID=

# Service-account credentials. Provide ONE of:
#   - GOOGLE_APPLICATION_CREDENTIALS_JSON: the raw JSON content of a service
#     account key, OR a base64-encoded version of that JSON. Recommended on
#     Netlify since the filesystem is ephemeral.
#   - GOOGLE_APPLICATION_CREDENTIALS: filesystem path to a service-account
#     key JSON file. Useful for local development.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=

# Vertex AI region. Defaults to us-central1 if unset.
VERTEX_AI_LOCATION=us-central1

# Imagen model name. Defaults to imagegeneration@006 if unset.
VERTEX_AI_IMAGEN_MODEL=imagegeneration@006

# ============================================================================
# Stripe Payments (Card + Apple Pay + Google Pay) — alongside PayPal
# ============================================================================
#
# Used by:
#   - /.netlify/functions/stripe-config (serves only the publishable key)
#   - /.netlify/functions/stripe-create-payment-intent
#   - /.netlify/functions/stripe-payment-status
#   - /.netlify/functions/stripe-webhook
#
# Keep this disabled until the complete key set, webhook endpoint, payment
# method domain, and isolated preview database have been configured. The
# runtime fails closed if the deploy context and key mode do not agree.
STRIPE_CHECKOUT_ENABLED=false

# Explicitly select the matching credential family. Use test for local,
# branch, and Deploy Preview validation. Production requires live.
STRIPE_MODE=test

# Browser-safe key returned by the same-origin stripe-config function only
# while Stripe checkout is safely enabled. Do not use a VITE_ variable: that
# would bake a preview/production key into the client bundle at build time.
STRIPE_PUBLISHABLE_KEY=

# Server-only secret key (sk_test_... or sk_live_...). NEVER expose to the
# browser — only used inside Netlify functions.
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_...) shown in the Stripe dashboard after
# registering https://<deploy-host>/.netlify/functions/stripe-webhook.
# Required: checkout remains unavailable when signature verification cannot
# be guaranteed.
STRIPE_WEBHOOK_SECRET=

# Existing paid-order background work (confirmation email, admin notification,
# analytics audit, and PDFs) uses this server-only shared secret. Set one
# cryptographically random value per isolated environment; never prefix VITE_.
# AUTH_SESSION_SECRET is the legacy fallback.
INTERNAL_JOB_SECRET=

# Required for Stripe unless AUTH_SESSION_SECRET is already configured. A
# dedicated stable server-only signing key keeps payment-bound confirmation and
# guest order-view credentials separate from login sessions.
ORDER_CONFIRMATION_TOKEN_SECRET=

# Use a separate Neon branch/database for Stripe test mode. Netlify Functions
# currently prefer NETLIFY_DATABASE_URL, with DATABASE_URL as a fallback.
NETLIFY_DATABASE_URL=
